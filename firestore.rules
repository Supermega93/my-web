rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'supermegafx1@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'role']) &&
             data.keys().hasOnly(['id', 'name', 'email', 'role', 'access_status', 'can_access_masterclass', 'access_tier', 'tier_name', 'photoURL', 'phone', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             (data.id == request.auth.uid || isAdmin()) &&
             data.email is string && data.email.size() <= 120 &&
             data.role in ['customer', 'admin', 'developer'] &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('access_status' in data) || (data.access_status in ['free', 'paid', 'complimentary'])) &&
             (!('can_access_masterclass' in data) || data.can_access_masterclass is bool) &&
             (!('access_tier' in data) || (data.access_tier is string && data.access_tier.size() <= 50)) &&
             (!('tier_name' in data) || (data.tier_name is string && data.tier_name.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidUserProgress(data) {
      return data.keys().hasAll(['userId', 'lessonId', 'completed']) &&
             data.keys().hasOnly(['userId', 'lessonId', 'completed', 'score', 'completedAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.lessonId is string && data.lessonId.size() <= 100 &&
             data.completed is bool &&
             (!('score' in data) || data.score is number) &&
             (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 50));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['name', 'email', 'product', 'amount', 'status', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 120 &&
             data.product is string && data.product.size() > 0 && data.product.size() <= 150 &&
             data.amount is number &&
             data.status == 'pending' &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('reference' in data) || (data.reference is string && data.reference.size() <= 100)) &&
             (!('productId' in data) || (data.productId is string && data.productId.size() <= 100)) &&
             (!('productName' in data) || (data.productName is string && data.productName.size() <= 150)) &&
             (!('currency' in data) || (data.currency is string && data.currency.size() <= 10)) &&
             (!('paymentStatus' in data) || data.paymentStatus == 'pending') &&
             (!('transactionId' in data) || (data.transactionId is string && data.transactionId.size() <= 128)) &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidEAProject(data) {
      return data.keys().hasAll(['id', 'userId', 'projectName', 'platform', 'status']) &&
             data.keys().hasOnly(['id', 'userId', 'projectName', 'platform', 'status', 'strategyDescription', 'complexity', 'quoteAmount', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.projectName is string && data.projectName.size() <= 150 &&
             data.platform is string && data.platform.size() <= 50 &&
             data.status in ['draft', 'review', 'quote_ready', 'in_development', 'testing', 'completed', 'delivered', 'cancelled'] &&
             (!('strategyDescription' in data) || (data.strategyDescription is string && data.strategyDescription.size() <= 5000)) &&
             (!('complexity' in data) || (data.complexity is string && data.complexity.size() <= 50)) &&
             (!('quoteAmount' in data) || data.quoteAmount is number) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    function isValidTradingAccount(data) {
      return data.keys().hasAll(['id', 'userId', 'accountId', 'accountType', 'platform', 'broker', 'eaName']) &&
             data.keys().hasOnly(['id', 'userId', 'accountId', 'accountType', 'platform', 'broker', 'eaName', 'server', 'currency', 'initialBalance', 'currentBalance', 'equity', 'profit', 'profitPercentage', 'dailyProfit', 'dailyProfitPercentage', 'winRate', 'profitFactor', 'maxDrawdown', 'totalTrades', 'winningTrades', 'losingTrades', 'openPositions', 'status', 'lastSyncAt', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.accountId is string && data.accountId.size() <= 100 &&
             data.accountType in ['live', 'demo'] &&
             data.platform in ['MT5', 'MT4', 'cTrader', 'TradingView', 'Other'] &&
             data.broker is string && data.broker.size() <= 100 &&
             data.eaName is string && data.eaName.size() <= 150 &&
             (!('server' in data) || (data.server is string && data.server.size() <= 100)) &&
             (!('currency' in data) || (data.currency is string && data.currency.size() <= 10)) &&
             (!('initialBalance' in data) || data.initialBalance is number) &&
             (!('currentBalance' in data) || data.currentBalance is number) &&
             (!('equity' in data) || data.equity is number) &&
             (!('profit' in data) || data.profit is number) &&
             (!('profitPercentage' in data) || data.profitPercentage is number) &&
             (!('dailyProfit' in data) || data.dailyProfit is number) &&
             (!('dailyProfitPercentage' in data) || data.dailyProfitPercentage is number) &&
             (!('winRate' in data) || data.winRate is number) &&
             (!('profitFactor' in data) || data.profitFactor is number) &&
             (!('maxDrawdown' in data) || data.maxDrawdown is number) &&
             (!('totalTrades' in data) || data.totalTrades is number) &&
             (!('winningTrades' in data) || data.winningTrades is number) &&
             (!('losingTrades' in data) || data.losingTrades is number) &&
             (!('openPositions' in data) || data.openPositions is number) &&
             (!('status' in data) || (data.status in ['active', 'paused', 'disconnected'])) &&
             (!('lastSyncAt' in data) || (data.lastSyncAt is string && data.lastSyncAt.size() <= 50)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    // Default Deny All Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection Test Collection
    match /test/{testId} {
      allow get: if true;
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isAdmin();

      // User Progress Subcollection
      match /progress/{lessonId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidId(lessonId) && isValidUserProgress(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Trading Accounts Subcollection for Portfolio Tracking
      match /trading_accounts/{accountId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && isValidId(accountId) && isValidTradingAccount(incoming());
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update, delete: if isAdmin();
    }

    // Projects Collection (Custom EA Requests)
    match /projects/{projectId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(projectId) && isValidEAProject(incoming());
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin()) && isValidId(projectId) && isValidEAProject(incoming());
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Test Connection Path
    match /test/connection {
      allow read: if true;
    }

    // Ebook Downloads Collection
    function isValidEbookDownload(data) {
      return data.keys().hasAll(['id', 'ebookId', 'downloadedAt']) &&
             data.keys().hasOnly(['id', 'ebookId', 'ebookTitle', 'userId', 'userEmail', 'source', 'downloadUrl', 'downloadedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.ebookId is string && data.ebookId.size() > 0 && data.ebookId.size() <= 100 &&
             data.downloadedAt is string && data.downloadedAt.size() <= 50 &&
             (!('ebookTitle' in data) || (data.ebookTitle is string && data.ebookTitle.size() <= 200)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 120)) &&
             (!('source' in data) || (data.source is string && data.source.size() <= 50)) &&
             (!('downloadUrl' in data) || (data.downloadUrl is string && data.downloadUrl.size() <= 500));
    }

    match /ebook_downloads/{downloadId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isValidId(downloadId) && isValidEbookDownload(incoming());
      allow update, delete: if isAdmin();
    }

    // App Assets Registry (Book covers, storefront media)
    function isValidAppAsset(data) {
      return data.keys().hasAll(['id', 'name', 'url']) &&
             data.keys().hasOnly(['id', 'name', 'type', 'productId', 'url', 'originalFilename', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.url is string && data.url.size() > 0 && data.url.size() <= 500 &&
             (!('type' in data) || (data.type is string && data.type.size() <= 50)) &&
             (!('productId' in data) || (data.productId is string && data.productId.size() <= 100)) &&
             (!('originalFilename' in data) || (data.originalFilename is string && data.originalFilename.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50));
    }

    match /app_assets/{assetId} {
      allow get: if true;
      allow list: if true;
      allow create, update: if isValidId(assetId) && isValidAppAsset(incoming());
      allow delete: if isAdmin();
    }
  }
}
